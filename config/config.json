{
  "bar": {
    "timeFormat": "ddd MMM d hh:mm:ss AP",
    "orientation": "top"
  },
  "font": "Noto Sans",
  "weather": {
    "getWeatherFromIp": false
  },
  "wallpaper": {
    "directory": "~/Pictures/wallpapers",
    "runMatugen": false
  },
  "packages": {
    "notifyOnStartUp": false,
    "notifyEveryDay": false
  },
  "battery": {
    "warnPercentage": 30,
    "autoPowerSaver": true
  },
  "notifications": {
    "toastDurationMs": 2000
  },
  "welcome": {
    "jokesFile": "/home/ryan/.config/wisp/jokes.txt"
  },
  "osd": {
    "duration": 1000,
    "orientation": "bottom",
    "scaleSize": 1.0
  }
}
