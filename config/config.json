{
    "bar": {
        "timeFormat": "ddd MMM d hh:mm:ss AP",
        "orientation": "top"
    },
    "font": "Noto Sans Mono",
    "wallpaper": {
        "directory": "~/Pictures/wallpapers"
    },
    "packages": {
        "notifyOnStartUp": true,
        "notifyEveryDay": true
    },
    "battery": {
        "warnPercentage": 30,
        "autoPowerSaver": true
    }
}