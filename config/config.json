{
    "bar": {
        "timeFormat": "ddd MMM d hh:mm:ss AP",
        "orientation": "top"
    },
    "font": "Noto Sans Mono",
    "wallpaper": {
        "directory": "~/Pictures/wallpapers",
        "runMatugen": false
    },
    "packages": {
        "notifyOnStartUp": true,
        "notifyEveryDay": true
    },
    "battery": {
        "warnPercentage": 30,
        "autoPowerSaver": true
    },
    "notifications": {
      "toastDurationMs": 3000
    },
    "welcome": {
      "jokesFile": "/home/ryan/.config/wisp/jokes.txt"
    },
    "osd": {
        "duration": 1000,
        "orientation": "top",
        "scaleSize": 1.0
    }
}
